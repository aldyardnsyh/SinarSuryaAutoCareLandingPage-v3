---
// 11. KontakLokasi — section navy, kartu putih + Google Maps embed resmi
// dari client (Konsep 3 §B.11; data asli Maps bengkel)
import { SITE, waLink, mapEmbedUrl, mapLinkUrl } from "../data/site";
import Icon from "./Icon.astro";

const sosmed = [
  { label: "Facebook", url: SITE.social.facebook },
  { label: "Instagram", url: SITE.social.instagram },
].filter((s) => s.url); // [DATA-CLIENT:link-sosmed]
---

<section class="kontak" id="kontak">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow eyebrow-light">Kontak &amp; Lokasi</p>
      <h2 class="h-light">Kunjungi Bengkel Kami</h2>
      <p class="sub sub-light">
        Mudah dijangkau dari Bojongsoang, Dayeuhkolot, Baleendah, dan
        Buahbatu.
      </p>
    </div>

    <div class="grid">
      <div class="card">
        <ul class="rows">
          <li>
            <span class="ico"><Icon name="pin" size={18} /></span>
            <div>
              <strong>Alamat Workshop</strong>
              <p>{SITE.address.full}</p>
            </div>
          </li>
          <li>
            <span class="ico"><Icon name="clock" size={18} /></span>
            <div>
              <strong>Jam Operasional</strong>
              <p class="sched">
                Servis mobil · {SITE.schedule.servis.label} 07.00–17.00
                <span class="status" id="status-servis">
                  <span class="dot" aria-hidden="true"></span>
                  <span class="status-text">Senin–Sabtu</span>
                </span>
              </p>
              <p class="sched">
                Cuci &amp; steam · {SITE.schedule.cuci.label} 07.00–17.00
                <span class="status" id="status-cuci">
                  <span class="dot" aria-hidden="true"></span>
                  <span class="status-text">Setiap hari</span>
                </span>
              </p>
            </div>
          </li>
          <li>
            <span class="ico"><Icon name="phone" size={18} /></span>
            <div>
              <strong>Telepon</strong>
              <p><a href={`tel:${SITE.phoneIntl}`}>{SITE.phone}</a></p>
            </div>
          </li>
          <li>
            <span class="ico"><Icon name="wa" size={18} /></span>
            <div>
              <strong>Chat WhatsApp</strong>
              <p>
                <a href={waLink(SITE.waConsult)} target="_blank" rel="noopener">
                  Konsultasi &amp; booking servis
                </a>
              </p>
            </div>
          </li>
        </ul>

        {
          sosmed.length > 0 && (
            <div class="sosmed">
              {sosmed.map((s) => (
                <a href={s.url} target="_blank" rel="noopener" class="sos-link">
                  {s.label}
                </a>
              ))}
            </div>
          )
        }

        <a class="btn btn-primary maps-btn" href={mapLinkUrl} target="_blank" rel="noopener">
          <Icon name="pin" size={18} /> Buka di Google Maps
        </a>
      </div>

      <div class="map-wrap">
        <iframe
          src={mapEmbedUrl}
          title="Peta lokasi Sinar Surya Auto Care, Jl. Cijagra No.8, Bojongsoang, Kab. Bandung"
          loading="lazy"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  // Chip status buka/tutup per layanan, realtime dari jam perangkat (WIB).
  import { SITE } from "../data/site";

  function updateChips() {
    const fmt = new Intl.DateTimeFormat("en-US", {
      timeZone: "Asia/Jakarta",
      hour: "numeric",
      minute: "numeric",
      hour12: false,
      weekday: "short",
    });
    const parts = Object.fromEntries(
      fmt.formatToParts(new Date()).map((p) => [p.type, p.value])
    );
    const dayMap: Record<string, number> = {
      Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6,
    };
    const day = dayMap[parts.weekday] ?? new Date().getDay();
    const minutes =
      (parseInt(parts.hour, 10) % 24) * 60 + parseInt(parts.minute, 10);
    const { open, close } = SITE.schedule;
    const dalamJam = minutes >= open && minutes < close;

    const chips: Array<[string, boolean]> = [
      ["status-servis", SITE.schedule.servis.hari.includes(day) && dalamJam],
      ["status-cuci", SITE.schedule.cuci.hari.includes(day) && dalamJam],
    ];

    for (const [id, buka] of chips) {
      const el = document.getElementById(id);
      if (!el) continue;
      el.classList.toggle("closed", !buka);
      const teks = el.querySelector(".status-text");
      if (teks) teks.textContent = buka ? "Buka sekarang" : "Tutup sekarang";
    }
  }

  updateChips();
  setInterval(updateChips, 30_000);
</script>

<style>
  .kontak {
    background: var(--color-navy);
    color: #fff;
    padding-block: var(--section-y);
    border-radius: clamp(24px, 4vw, 48px) clamp(24px, 4vw, 48px) 0 0;
  }

  .eyebrow-light {
    color: var(--color-accent);
  }

  .h-light {
    color: #fff;
  }

  .sub-light {
    color: rgba(255, 255, 255, 0.75);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2.25rem;
  }

  .card {
    background: var(--color-card);
    color: var(--color-navy);
    border-radius: var(--radius-card-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-lift);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .rows li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .ico {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-wash);
    color: var(--color-wash-deep);
    flex-shrink: 0;
  }

  strong {
    font-size: 0.9375rem;
  }

  .rows p {
    font-size: 0.9rem;
    color: var(--color-navy-soft);
  }

  .sched {
    margin-top: 0.25rem;
  }

  /* chip status buka/tutup per layanan, diperbarui realtime oleh JS */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: 0.4rem;
    padding: 0.1rem 0.6rem;
    border-radius: var(--radius-pill);
    background: rgba(37, 211, 102, 0.12);
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    color: #1a7f4b;
    vertical-align: middle;
  }

  .status.closed {
    background: rgba(186, 26, 26, 0.08);
    color: var(--color-navy-soft);
  }

  .status .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-wa);
  }

  .status.closed .dot {
    background: #d64545;
  }

  .rows a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .sosmed {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.4rem;
  }

  .sos-link {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-hairline);
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--color-navy);
    text-decoration: none;
  }

  .sos-link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .maps-btn {
    margin-top: 1.5rem;
    width: 100%;
  }

  .map-wrap {
    border-radius: var(--radius-card-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
    min-height: 320px;
  }

  .map-wrap iframe {
    width: 100%;
    height: 100%;
    min-height: 320px;
    border: 0;
    display: block;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 5fr 7fr;
    }

    .map-wrap,
    .map-wrap iframe {
      min-height: 440px;
    }
  }
</style>
