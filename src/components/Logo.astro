---
// Logo "matahari tersenyum": sun amber + gear teal (Konsep 3 §B.2)
interface Props {
  size?: number;
}
const { size = 40 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Logo Sinar Surya Auto Care, matahari tersenyum dengan gear"
>
  <!-- Gear teal -->
  <g stroke="#0E9594" stroke-width="3" stroke-linecap="round" fill="none">
    <circle cx="24" cy="24" r="10"></circle>
    <path d="M24 8v4M24 36v4M8 24h4M36 24h4M12.7 12.7l2.8 2.8M32.5 32.5l2.8 2.8M35.3 12.7l-2.8 2.8M15.5 32.5l-2.8 2.8"></path>
  </g>
  <!-- Sun amber tersenyum -->
  <circle cx="24" cy="24" r="7.5" fill="#F2B705"></circle>
  <circle cx="21.5" cy="22.5" r="1.1" fill="#22364F"></circle>
  <circle cx="26.5" cy="22.5" r="1.1" fill="#22364F"></circle>
  <path
    d="M21 26.5c1.8 1.6 4.2 1.6 6 0"
    stroke="#22364F"
    stroke-width="1.4"
    stroke-linecap="round"
    fill="none"></path>
</svg>
