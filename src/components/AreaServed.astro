<section class="served" aria-label="Daerah yang kami layani">
  <div class="container">
    <h2>Daerah yang Kami Layani</h2>
    <p class="sub">Bengkel di Bojongsoang, mudah dicapai dari area sekitarnya.</p>
    <ul>
      <li><a href="/area/dayeuhkolot">Bengkel mobil Dayeuhkolot</a><span>sekitar 10 menit</span></li>
      <li><a href="/area/baleendah">Bengkel mobil Baleendah</a><span>sekitar 15 menit</span></li>
      <li><a href="/#kontak">Bengkel mobil Buahbatu</a><span>sekitar 20 menit</span></li>
      <li><a href="/#kontak">Bengkel mobil Bojongsoang</a><span>di lokasi</span></li>
    </ul>
  </div>
</section>
<style>
  .served { padding-block: var(--section-y); background: var(--color-wash); border-radius: clamp(24px,4vw,48px); margin-inline: max(1rem, calc((100% - 1120px)/2)); }
  .container { text-align: center; }
  h2 { font-size: clamp(1.4rem,3vw,2rem); font-weight: 800; color: var(--color-navy); }
  .sub { color: var(--color-navy-soft); margin-top: .5rem; }
  ul { list-style: none; margin: 1.5rem auto 0; padding: 0; display: grid; gap: .6rem; max-width: 560px; text-align: left; }
  li { background: var(--color-card); border-radius: 14px; padding: .8rem 1.1rem; display: flex; justify-content: space-between; gap: 1rem; box-shadow: var(--shadow-rest); }
  a { color: var(--color-primary); font-weight: 700; text-decoration: none; }
  span { color: var(--color-navy-soft); font-size: .85rem; }
</style>
