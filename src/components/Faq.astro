---
// FAQ — pertanyaan yang sering diketik orang di Google soal bengkel di
// Bojongsoang (sumber keyword bank 02-copywriting.md §15 + riset SERP).
// Pakai <details> native: interaktif tanpa JS, ramah SEO.
// Jawaban yang sama juga di-embed sebagai FAQPage JSON-LD di BaseLayout.
import Icon from "./Icon.astro";

export interface Faq {
  q: string;
  a: string;
}

export const FAQS: Faq[] = [
  {
    q: "Di mana persis lokasinya dan bagaimana rutenya?",
    a: "Patokannya Jl. Cijagra No.8, Bojongsoang, Kab. Bandung 40288. Dari arah Dayeuhkolot tinggal lurus ke Bojongsoang sekitar 10 menit, dari Baleendah sekitar 15 menit lewat jalan utama. Ketik Sinar Surya Auto Care di Google Maps dan ikuti pinnya, bengkel ada di sisi jalan yang mudah disinggahi.",
  },
  {
    q: "Apakah mudah dijangkau dari Dayeuhkolot atau Baleendah?",
    a: "Mudah. Pelanggan kami banyak yang datang dari Dayeuhkolot, Baleendah, dan Buahbatu karena posisinya di tengah jalur harian. Jalan menuju sini lebar dan bisa dilalui semua jenis mobil keluarga. Kalau ragu rute, chat WhatsApp dulu dan kami pandu sampai tiba.",
  },
  {
    q: "Bagaimana jam buka di hari libur dan akhir pekan?",
    a: "Cuci hidrolik dan steam wash buka setiap hari termasuk Minggu dan hari libur, pukul 07.00 sampai 17.00 WIB. Khusus servis dan perbaikan mobil hanya Senin sampai Sabtu. Saat akhir pekan antrean cuci biasanya ramai, jadi booking via WhatsApp lebih aman.",
  },
  {
    q: "Apakah ada tempat tunggu yang nyaman?",
    a: "Ada. Ruang tunggunya teduh dan santai untuk keluarga, anak bisa ikut menunggu dengan tenang. Sambil menunggu, mekanik menjelaskan kondisi mobil dengan bahasa yang mudah dipahami sebelum pengerjaan dimulai.",
  },
];
---

<section class="faq" id="faq" aria-label="Pertanyaan yang sering diajukan">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Tanya Jawab</p>
      <h2>Pertanyaan yang Sering Diajukan</h2>
      <p class="sub">
        Jawaban singkat soal lokasi, jam buka, harga, dan cara booking di
        bengkel mobil &amp; cuci hidrolik Bojongsoang.
      </p>
    </div>

    <div class="faq-list">
      {
        FAQS.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>
              <span class="q">{f.q}</span>
              <span class="chev" aria-hidden="true">
                <Icon name="arrow" size={18} />
              </span>
            </summary>
            <p class="a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--section-y);
  }

  .faq-list {
    max-width: 780px;
    margin: 2.25rem auto 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: var(--color-card);
    border: 1px solid rgba(34, 54, 79, 0.08);
    border-radius: 16px;
    box-shadow: var(--shadow-rest);
    overflow: hidden;
    transition: box-shadow 0.2s ease;
  }

  .faq-item:hover {
    box-shadow: var(--shadow-card);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    cursor: pointer;
    padding: 1rem 1.25rem;
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-navy);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chev {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-wash);
    color: var(--color-wash-deep);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  details[open] .chev {
    transform: rotate(90deg);
  }

  .a {
    padding: 0 1.25rem 1.1rem;
    color: var(--color-navy-soft);
    font-size: 0.9375rem;
    line-height: 1.7;
  }
</style>
