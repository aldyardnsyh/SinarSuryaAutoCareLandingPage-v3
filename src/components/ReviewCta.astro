---
// ReviewCTA — ajakan menulis ulasan Google (growth bengkel).
// Rating asli dari listing Maps; link menuju listing agar pelanggan
// tinggal tekan "Tulis ulasan".
import { SITE, mapLinkUrl } from "../data/site";
import Icon from "./Icon.astro";
---

<section class="review-cta" aria-label="Ajakan menulis ulasan Google">
  <div class="container inner">
    <div class="copy">
      <div class="score-wrap" aria-label={`Rating ${SITE.rating.score} dari ${SITE.rating.count} ulasan Google`}>
        <span class="score">{SITE.rating.score}</span>
        <span class="stars" aria-hidden="true">
          {Array.from({ length: 5 }).map(() => <Icon name="star" size={18} filled />)}
        </span>
        <span class="count">{SITE.rating.count} ulasan Google</span>
      </div>
      <h2>Puas dengan pengerjaan kami?</h2>
      <p>
        Ulasan Anda sangat membantu bengkel kami dikenal lebih banyak orang
        di Bojongsoang dan sekitarnya. Butuh satu menit saja.
      </p>
    </div>
    <a class="btn btn-wa review-btn" href={mapLinkUrl} target="_blank" rel="noopener"
      aria-label="Tulis ulasan untuk Sinar Surya Auto Care di Google Maps">
      <Icon name="star" size={20} filled /> Tulis Ulasan di Google
    </a>
  </div>
</section>

<style>
  .review-cta {
    padding-block: var(--space-lg);
    margin-top: calc(-1 * var(--space-sm));
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    background: var(--color-card);
    border: 1.5px dashed rgba(14, 149, 148, 0.45);
    border-radius: var(--radius-card-lg);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    box-shadow: var(--shadow-rest);
  }

  .score-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .score {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-navy);
    line-height: 1;
  }

  .stars {
    display: flex;
    gap: 0.1rem;
    color: var(--color-accent);
  }

  .count {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--color-navy-soft);
  }

  h2 {
    font-size: clamp(1.25rem, 2.8vw, 1.625rem);
    font-weight: 800;
    margin-top: 0.5rem;
  }

  p {
    margin-top: 0.5rem;
    color: var(--color-navy-soft);
    max-width: 560px;
  }

  .review-btn {
    background: var(--color-navy);
    box-shadow: var(--shadow-card);
  }

  .review-btn:hover {
    background: #182636;
  }

  @media (min-width: 900px) {
    .inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .review-btn {
      flex-shrink: 0;
    }
  }
</style>
