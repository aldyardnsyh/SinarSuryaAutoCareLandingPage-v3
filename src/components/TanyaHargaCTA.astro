---
// 7. TanyaHargaCTA — banner amber, pengganti pricelist (Konsep 3 §B.7)
import { waLink, SITE } from "../data/site";
import Icon from "./Icon.astro";
---

<section class="harga">
  <div class="container">
    <div class="banner">
      <div class="copy">
        <p class="eyebrow"><Icon name="chat" size={15} /> Tanpa Antrian &amp; Tanpa Bingung</p>
        <h2>Butuh Info Harga? Chat Aja!</h2>
        <p class="sub">
          Setiap kendaraan berbeda kondisi. Kirim keluhan atau foto mobil Anda
          via WhatsApp, kami bantu cek.
        </p>
      </div>
      <a
        href={waLink(`${SITE.waPrice} servis mobil saya.`)}
        target="_blank"
        rel="noopener"
        class="btn btn-navy"
        aria-label="Tanya harga via WhatsApp Sinar Surya Auto Care">
        <Icon name="wa" size={20} filled /> Tanya Harga via WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .harga {
    padding-block: var(--space-md);
  }

  .banner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    background: var(--color-accent);
    border-radius: var(--radius-card-lg);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    box-shadow: var(--shadow-card);
    position: relative;
    overflow: hidden;
  }

  /* dekorasi lingkaran lembut */
  .banner::after {
    content: "";
    position: absolute;
    right: -80px;
    top: -80px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
  }

  .eyebrow {
    color: var(--color-accent-dark);
    opacity: 0.8;
  }

  h2 {
    margin-top: 0.5rem;
    font-size: clamp(1.5rem, 3.4vw, 2.125rem);
    font-weight: 800;
    color: var(--color-accent-dark);
  }

  .sub {
    margin-top: 0.6rem;
    max-width: 560px;
    color: rgba(91, 67, 0, 0.85);
  }

  .btn {
    position: relative;
    z-index: 1;
  }

  @media (min-width: 900px) {
    .banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
