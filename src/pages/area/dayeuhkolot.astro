---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopInfoBar from "../../components/TopInfoBar.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFloat from "../../components/WhatsAppFloat.astro";
import { SITE, waLink } from "../../data/site";
const wa = waLink("Halo, saya dari Dayeuhkolot. Saya mau tanya soal servis mobil saya.");
const crumbs = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Beranda", item: `${SITE.domain}/` }, { "@type": "ListItem", position: 2, name: "Bengkel Mobil Dayeuhkolot", item: `${SITE.domain}/area/dayeuhkolot` }] };
const svc = { "@context": "https://schema.org", "@type": "Service", name: "Bengkel Mobil untuk Warga Dayeuhkolot", provider: { "@type": "AutoRepair", name: SITE.name, url: SITE.domain }, areaServed: "Dayeuhkolot", url: `${SITE.domain}/area/dayeuhkolot` };
---
<BaseLayout title="Bengkel Mobil Dayeuhkolot | Dekat, Mudah, Ramah Keluarga" description="Dari Dayeuhkolot ke Sinar Surya Auto Care sekitar 10 menit. Servis rutin, ganti oli, AC, dan cuci hidrolik di Jl. Cijagra No.8, Bojongsoang. Chat WhatsApp 0812-2022-203.">
<TopInfoBar /><Navbar />
<main id="konten-utama" class="container page">
<nav aria-label="Breadcrumb"><a href="/">Beranda</a> / Bengkel Mobil Dayeuhkolot</nav>
<h1>Bengkel Mobil Langganan Warga Dayeuhkolot</h1>
<p>Banyak pelanggan kami berangkat dari Dayeuhkolot pagi hari, menitipkan mobil, lalu mengambilnya sepulang kerja. Jaraknya sekitar 3 sampai 4 km atau sekitar 10 menit lewat jalan utama Bojongsoang Dayeuhkolot. Rutenya lurus dan mudah, cocok untuk mobil keluarga harian.</p>
<h2>Rute umum dari Dayeuhkolot</h2>
<p>Dari pasar Dayeuhkolot ambil arah Bojongsoang, ikuti jalan sampai kawasan Cijagra. Bengkel ada di Jl. Cijagra No.8, sisi jalan yang gampang disinggahi tanpa putar jauh. Kalau bingung, ketik Sinar Surya Auto Care di Google Maps dan ikuti pinnya.</p>
<h2>Layanan yang sering dipesan warga Dayeuhkolot</h2>
<ul><li>Ganti oli dan servis rutin mobil komuter</li><li>Service AC yang kurang dingin dipakai harian</li><li>Cuci hidrolik kolong setelah musim hujan</li></ul>
<p><a class="btn btn-primary" href={wa} target="_blank" rel="noopener">Chat WhatsApp dari Dayeuhkolot</a></p>
<p class="alt">Lihat juga: <a href="/area/baleendah">bengkel mobil Baleendah</a> dan <a href="/layanan">semua layanan</a>.</p>
</main>
<Footer /><WhatsAppFloat />
<script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
<script type="application/ld+json" set:html={JSON.stringify(svc)} />
</BaseLayout>
<style>
.page { padding-block: 2rem 3rem; max-width: 760px; }
.page h1 { font-size: clamp(1.6rem,4vw,2.4rem); color: var(--color-navy); }
.page h2 { margin-top: 1.6rem; color: var(--color-navy); }
.page p, .page li { line-height: 1.75; color: var(--color-navy-soft); }
.page nav { font-size: .85rem; margin-bottom: 1rem; }
.alt { margin-top: 1rem; }
</style>
